# ---- Python -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Data ---------------------------------------------------
# Raw multi-megabyte source workbooks are excluded
data/raw/*
!data/raw/.gitkeep
# Exclude raw interim csv/gz, but track optimized clean parquet for fast dashboard loading
data/interim/*
!data/interim/.gitkeep
!data/interim/transactions_clean.parquet

# Include processed pipeline outputs so Streamlit Cloud can render immediately
!data/processed/*

# ---- Model artefacts and runs -------------------------------
!models/*.pkl
mlruns/
mlflow/

# ---- Reports (regenerate with the pipeline) -----------------
reports/figures/*
!reports/figures/.gitkeep

# ---- Notebooks ----------------------------------------------
.ipynb_checkpoints/

# ---- Tooling ------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
Thumbs.db
